includes:
    - ./vendor/larastan/larastan/extension.neon
parameters:
    level: 0
    paths:
        - packages
    excludePaths:
        - packages/*/config/*
        - packages/*/tests/*
        - packages/vendor/*
        - packages/*/vendor/*
    checkOctaneCompatibility: true
    ignoreErrors:
        # ColumnType and Position are verbatim ports of the prototype's static-factory
        # value objects (Task 7); they are not final and are not intended to be subclassed.
        -
            identifier: new.static
            path: packages/panel/src/Tables/Support/ColumnType.php
        -
            identifier: new.static
            path: packages/panel/src/Tables/Support/Position.php
