{
    "name": "lunarphp/core",
    "description": "Lunar Laravel e-commerce core functionality.",
    "keywords": [
        "lunar",
        "laravel",
        "ecommerce",
        "e-commerce",
        "headless",
        "store",
        "shop",
        "cart"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lunar",
            "homepage": "https://lunarphp.io/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Lunar\\Core\\": "src",
            "Lunar\\Core\\Database\\Factories\\": "database/factories",
            "Lunar\\Core\\Database\\Seeders\\": "database/seeders",
            "Lunar\\Core\\Database\\State\\": "database/state"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lunar\\Core\\LunarServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-exif": "*",
        "ext-intl": "*",
        "laravel/framework": "^12.0|^13.0",
        "spatie/laravel-medialibrary": "^11.12.7",
        "spatie/laravel-activitylog": "^4.10.1",
        "laravel/scout": "^10.13.1",
        "lunarphp/nestedset": "^1.0",
        "lukascivil/treewalker": "0.9.1",
        "spatie/php-structure-discoverer": "^2.3.1",
        "spatie/laravel-blink": "^1.7.1",
        "spatie/laravel-permission": "^6.12",
        "spatie/laravel-model-states": "^2.11"
    }
}
