{
  "name": "lunarphp/api",
  "type": "project",
  "description": "Storefront and admin HTTP APIs for LunarPHP",
  "keywords": ["lunarphp", "laravel", "ecommerce", "e-commerce", "headless", "store", "shop", "api", "rest"],
  "license": "MIT",
  "authors": [
    {
      "name": "Lunar",
      "homepage": "https://lunarphp.io/"
    }
  ],
  "require": {
    "php": "^8.4",
    "lunarphp/core": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Lunar\\Api\\": "src/",
      "Lunar\\Api\\Database\\Factories\\": "database/factories"
    }
  },
  "extra": {
    "lunar": {
      "name": "API"
    },
    "laravel": {
      "providers": [
        "Lunar\\Api\\ApiServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  }
}
