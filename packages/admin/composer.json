{
    "name": "lunarphp/admin",
    "description": "Admin panel for LunarPHP",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Lunar\\Admin\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "minimum-stability": "dev",
    "repositories": [],
    "require": {
        "lunarphp/core": "self.version",
        "lunarphp/filament": "self.version",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "mallardduck/blade-lucide-icons": "^1.26"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lunar\\Admin\\LunarPanelProvider"
            ]
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.17"
    }
}
