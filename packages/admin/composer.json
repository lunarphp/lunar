{
    "name": "lunarphp/lunar",
    "description": "Admin panel for LunarPHP",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Lunar\\Admin\\": "src/",
            "Lunar\\Admin\\Database\\Factories\\": "database/factories",
            "Lunar\\Admin\\Database\\State\\": "database/state"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "minimum-stability": "dev",
    "repositories": [],
    "require": {
        "lunarphp/core": "self.version",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "spatie/laravel-permission": "^6.12",
        "barryvdh/laravel-dompdf": "^3.0",
        "technikermathe/blade-lucide-icons": "^v3.0",
        "leandrocfe/filament-apex-charts": "^5.0",
        "awcodes/shout": "^4.0",
        "awcodes/filament-badgeable-column": "^4.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lunar\\Admin\\LunarPanelProvider"
            ]
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.17"
    }
}
