{
    "name": "lunarphp/lunar",
    "description": "Admin panel for LunarPHP",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Lunar\\Admin\\": "src/",
            "Lunar\\Admin\\Database\\Factories\\": "database/factories",
            "Lunar\\Admin\\Database\\State\\": "database/state"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "minimum-stability": "dev",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ralphjsmit/filament-apex-charts"
        }
    ],
    "require": {
        "lunarphp/core": "self.version",
        "filament/filament": "^4.0",
        "filament/spatie-laravel-media-library-plugin": "^4.0",
        "spatie/laravel-permission": "^6.12",
        "barryvdh/laravel-dompdf": "^3.0",
        "technikermathe/blade-lucide-icons": "^v3.0",
        "leandrocfe/filament-apex-charts": "dev-rjs/v4-upgrade",
        "awcodes/shout": "^v3.0.0-beta.2",
        "awcodes/filament-badgeable-column": "^v3.0.0-beta.1"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lunar\\Admin\\LunarPanelProvider"
            ]
        }
    },
    "require-dev": {
        "filament/upgrade": "^4.0",
        "phpstan/phpstan": "2.1.17"
    }
}
