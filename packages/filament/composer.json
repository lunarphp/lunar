{
    "name": "lunarphp/filament",
    "description": "Filament components, widgets, and schemas for Lunar — composable building blocks for any Filament v5 panel.",
    "license": "MIT",
    "keywords": [
        "lunar",
        "laravel",
        "filament",
        "ecommerce",
        "headless"
    ],
    "authors": [
        {
            "name": "Lunar",
            "homepage": "https://lunarphp.io/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Lunar\\Filament\\": "src/",
            "Lunar\\Filament\\Database\\Factories\\": "database/factories"
        }
    },
    "minimum-stability": "dev",
    "require": {
        "php": "^8.3",
        "lunarphp/core": "self.version",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "mallardduck/blade-lucide-icons": "^1.26"
    },
    "extra": {
        "lunar": {
            "name": "Filament Bridge"
        },
        "laravel": {
            "providers": [
                "Lunar\\Filament\\LunarFilamentServiceProvider"
            ]
        }
    }
}
