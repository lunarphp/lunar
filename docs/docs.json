{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lunar PHP",
  "colors": {
    "primary": "#4bc7f8",
    "light": "#4bc7f8",
    "dark": "#4bc7f8"
  },
  "background": {
    "decoration": "grid"
  },
  "fonts": {
    "heading": {
      "family": "Poppins"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/lunarphp/lunar"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://lunarphp.com",
      "x": "https://x.com/lunarphp",
      "github": "https://github.com/lunarphp",
      "discord": "https://lunarphp.com/discord",
      "linkedin": "https://linkedin.com/company/lunarphp"
    }
  },
